# Copie este arquivo para .env e preencha os valores reais.
# NUNCA comite o .env no Git.

# ─── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=cole-aqui-uma-chave-aleatoria-de-50-caracteres
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── IA — Providers (multi-provider com fallback) ────────────────────────────
# Ordem dos providers a tentar. O primeiro com chave configurada ganha.
AI_PROVIDER_ORDER=groq,gemini

# Groq (RECOMENDADO) — 30 req/min grátis, super rápido
# Cadastre em: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (FALLBACK) — 1500 req/dia grátis
# Cadastre em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Timeout de chamadas IA (segundos). 30 evita travar worker se provider ficar lento.
# Aumente para management commands longos (AI_TIMEOUT_SECONDS=120).
AI_TIMEOUT_SECONDS=30
# Threshold para alerta "IA lenta" (ms). Dispara notificação após esse tempo.
AI_LATENCIA_ALERTA_MS=15000

# ─── Cache (produção) ────────────────────────────────────────────────────────
# Em dev: sem CACHE_URL, usa filesystem local (funciona out-of-the-box)
# Em prod: use Redis para performance e rate-limit distribuído.
# Ex.: Railway/Render provisionam Redis com uma variável REDIS_URL — cole aqui.
# CACHE_URL=redis://default:senha@host:6379/0
CACHE_URL=

# ─── Analytics (opcional) ────────────────────────────────────────────────────
# Plausible: privacy-first, cookieless, agregado. Não precisa opt-in por LGPD.
#   Cadastre em https://plausible.io e cole seu domínio (ex.: santuarioedu.com.br)
# GA4: mais completo, mas exige opt-in do usuário (respeita cookie banner)
#   https://analytics.google.com → nova propriedade → copie o Measurement ID.
PLAUSIBLE_DOMAIN=
GA_MEASUREMENT_ID=

# ─── Mercado Pago (checkout) ─────────────────────────────────────────────────
# 1. Crie conta em https://www.mercadopago.com.br/developers
# 2. Vá em "Suas integrações" → crie/selecione uma aplicação
# 3. Em "Credenciais": copie o Access Token de TESTE (TEST-xxx) para dev
#    e o de PRODUÇÃO (APP_USR-xxx) para produção.
# 4. Public Key só é necessária se for usar Bricks/SDK frontend.
# 5. SITE_URL precisa ser HTTPS pública para webhooks funcionarem
#    (use ngrok em dev: ngrok http 8000 e cole a URL abaixo).
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
SITE_URL=http://127.0.0.1:8000

# ─── Web Push / VAPID (PWA notifications) ────────────────────────────────────
# Gere com: vapidkeys generate  (ou: py-vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUB=mailto:admin@seudominio.com

# ─── E-mail SMTP (deixe EMAIL_HOST vazio em dev) ─────────────────────────────
# Opções recomendadas: SendGrid (https://sendgrid.com), Mailgun, AWS SES, Gmail
# Exemplo Gmail (precisa criar senha de app):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_HOST_USER=seu@gmail.com
#   EMAIL_HOST_PASSWORD=senha-de-app-de-16-chars
# Exemplo SendGrid:
#   EMAIL_HOST=smtp.sendgrid.net
#   EMAIL_HOST_USER=apikey
#   EMAIL_HOST_PASSWORD=SG.xxxxxxxxxxxx
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=SantuarioEdu <noreply@seudominio.com>
SERVER_EMAIL=

# ─── Sentry — Monitoramento de erros em produção ─────────────────────────────
# Cadastre-se grátis em https://sentry.io (5k erros/mês free)
# SENTRY_DSN=https://xxxxxxxxxx@oXXXX.ingest.sentry.io/YYYY
SENTRY_DSN=
SENTRY_ENV=development
SENTRY_TRACES_RATE=0.1
SENTRY_PROFILES_RATE=0.0
SENTRY_RELEASE=

# ─── Limites de Plano (ajuste sem mexer no código) ───────────────────────────
LIMIT_FREE_QUESTOES_DIA=30
LIMIT_FREE_SIMULADOS_SEMANA=1
LIMIT_FREE_IA_DIA=3
LIMIT_FREE_FLASHCARDS=50
LIMIT_PRO_QUESTOES_DIA=999999
LIMIT_PRO_SIMULADOS_SEMANA=999999
LIMIT_PRO_IA_DIA=30
LIMIT_PRO_FLASHCARDS=999999

# ─── Notificações Internas (alertas pro dono do projeto) ─────────────────────
# Recebe: 500 errors, novos tickets, logs ERRO/CRITICO — em tempo real.
# Configure PELO MENOS UM canal:
#
# Discord: crie webhook em Server Settings → Integrations → Webhooks → copie URL
NOTIFY_DISCORD_WEBHOOK=
#
# Telegram: fale com @BotFather no Telegram → /newbot → copie o token
# Depois envie /start pro bot e pegue seu chat_id em:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
NOTIFY_TELEGRAM_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
#
# Email pessoal — recebe alertas 'alta' e 'critica' (500, quota IA esgotada etc)
ADMIN_EMAIL=

# ─── E-mails de suporte (configure quando tiver domínio próprio) ─────────────
# Ainda não tem? Deixe vazio — o sistema funciona pela página de tickets.
SUPORTE_EMAIL=suporte@santuarioedu.com.br
FINANCEIRO_EMAIL=financeiro@santuarioedu.com.br
PRIVACIDADE_EMAIL=privacidade@santuarioedu.com.br
