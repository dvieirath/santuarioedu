release: echo "=== RELEASE START ===" && python manage.py migrate --noinput && python manage.py axes_reset && (python manage.py createsuperuser --noinput 2>&1 || echo "[SU] pulou (ja existe)") && echo "=== PWD:" && pwd && echo "=== LS data_export:" && ls -la data_export/ 2>&1 || echo "[!] pasta data_export nao existe" && echo "=== GUNZIP:" && (gunzip -f data_export/backup_quiz.json.gz 2>&1 && echo "[GZ] ok" || echo "[GZ] FALHOU") && echo "=== LS pos-gunzip:" && ls -la data_export/ 2>&1 && echo "=== LOADDATA:" && python manage.py loaddata data_export/backup_quiz.json 2>&1 && echo "=== RELEASE END OK ==="
web: gunicorn prf_master.wsgi --bind 0.0.0.0:$PORT --workers 3 --threads 2 --timeout 60 --access-logfile - --error-logfile -
